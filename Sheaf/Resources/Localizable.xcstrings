    "%lld pages have no text to select. Their writing is read on this Mac and laid over them invisibly, so the pages look the same but can be searched and copied from." : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld page has no text to select. Its writing is read on this Mac and laid over it invisibly, so the page looks the same but can be searched and copied from."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld pages have no text to select. Their writing is read on this Mac and laid over them invisibly, so the pages look the same but can be searched and copied from."
                }
              }
            }
          }
        },
        "ru" : {
          "variations" : {
            "plural" : {
              "few" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "На %lld страницах нет текста, который можно выделить. Текст будет распознан на этом Mac и невидимо наложен поверх, так что страницы выглядят как прежде, но по ним можно искать и копировать из них."
                }
              },
              "many" : {
