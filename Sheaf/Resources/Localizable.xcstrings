          "stringUnit" : {
            "state" : "translated",
            "value" : "Файл всё равно можно сохранить. Он будет ближе к стандарту, но проверку не пройдёт."
          }
        }
      }
    },
    "The font %@ is not in the file and is not installed on this Mac" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шрифта %@ нет в файле, и он не установлен на этом Mac"
          }
        }
      }
    },
    "The later version" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Более поздняя версия"
          }
        }
      }
    },
    "The markup tools add notes, shapes, stamps and your signature on top of the pages." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Инструменты разметки добавляют заметки, фигуры, штампы и вашу подпись поверх страниц."
          }
        }
